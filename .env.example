# GLM（OpenAI 兼容网关）。未设置 key 时自动进入离线模式（faux + 录制回放）
GLM_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
GLM_API_KEY=""
# 兼容旧变量名：STRATEGIC_BASE_URL / STRATEGIC_API_KEY

# 各角色模型
COMMANDER_MODEL="glm-5.3"
SPECIALIST_MODEL="glm-5.3-flash"

# 全局并发信号量（§2.6 实测 4 并发未触发 429，7 并发触发）
GLM_MAX_CONCURRENCY=3

# 价格（美元 / 百万 token）。网关未公开价格时保持 0，UI 会如实显示 0
GLM_PRICE_INPUT=0
GLM_PRICE_OUTPUT=0
GLM_PRICE_CACHE_READ=0
GLM_FLASH_PRICE_INPUT=0
GLM_FLASH_PRICE_OUTPUT=0
GLM_FLASH_PRICE_CACHE_READ=0
# 费用显示：USD 或 CNY（CNY 时按汇率换算）
COST_CURRENCY="CNY"
USD_CNY_RATE=7.1

SERVER_PORT=8787
WORLD_SEED=20261012
